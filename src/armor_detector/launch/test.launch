<launch>

    <arg name="bag" default="/root/bags/blue_guard.bag" />

    <node pkg="armor_detector" type="camera_node" name="camera_node" output="screen">
        <param name="image_topic" value="/hk_camera/image_raw" />
        <param name="camera_info_topic" value="/hk_camera/camera_info" />
        <param name="debug_topic" value="/ft/debug/image" />
        <param name="queue_size" value="1" />
    </node>

    <node pkg="rosbag" type="play" name="rosbag_play" output="screen"
          args="-l $(arg bag)" />

    <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view" output="screen" args="/ft/debug/image" />

</launch>
